{
  "manifest_version": 3,
  "name": "Caçador de Vídeos",
  "version": "1.1",
  "permissions": [
    "webRequest",
    "activeTab",
    "downloads",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}