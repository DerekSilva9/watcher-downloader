{
  "manifest_version": 3,
  "name": "Caçador de Vídeos",
  "version": "1.3",
  "permissions": [
    "webRequest",
    "activeTab",
    "downloads",
    "storage",
    "scripting",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [{
    "resources": ["libs/mp4box.all.min.js"],
    "matches": ["<all_urls>"]
  }]
}